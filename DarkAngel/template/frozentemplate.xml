	<Slider name="UIDarkAngelScrollBarSlider" virtual="true">
		<Size>
			<AbsDimension x="16" y="0"/>
		</Size>
		<Frames>
			<Button name="$parentScrollUpButton" inherits="UIDarkAngelScrollUpButton">
				<Anchors>
					<Anchor point="BOTTOM" relativePoint="TOP"/>
				</Anchors>
				<Scripts>
					<OnClick>
						local parent = self:GetParent();
						parent:SetValue(parent:GetValue() - (parent:GetHeight() / 2));
						PlaySound("UChatScrollButton");
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentScrollDownButton" inherits="UIDarkAngelScrollDownButton">
				<Anchors>
					<Anchor point="TOP" relativePoint="BOTTOM"/>
				</Anchors>
				<Scripts>
					<OnClick>
						local parent = self:GetParent();
						parent:SetValue(parent:GetValue() + (parent:GetHeight() / 2));
						PlaySound("UChatScrollButton");
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnValueChanged>
				self:GetParent():SetVerticalScroll(value);
			</OnValueChanged>
		</Scripts>
		<ThumbTexture name="$parentThumbTexture" inherits="UIDarkAngelScrollBarButton" file="Interface\AddOns\DarkAngel\template\UI-ScrollBar-Knob" alphaMode="ADD">
			<Size>
				<AbsDimension x="18" y="24"/>
			</Size>
			<TexCoords left="0.20" right="0.80" top="0.125" bottom="0.875"/>
		</ThumbTexture>
	</Slider>
	<ScrollFrame name="UIDarkAngelScrollFrame" virtual="true">
		<Frames>
			<Slider name="$parentScrollBar" inherits="UIDarkAngelScrollBarSlider">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="6" y="-16"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="6" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad>
				ScrollFrame_OnLoad(self);
			</OnLoad>
			<OnScrollRangeChanged>
				ScrollFrame_OnScrollRangeChanged(self, xrange, yrange);
			</OnScrollRangeChanged>
			<!--  The code to disable the ScrollDownButton is pretty hacked, but it works -->
			<OnVerticalScroll>
				local scrollbar = _G[self:GetName().."ScrollBar"];
				scrollbar:SetValue(offset);
				local min;
				local max;
				min, max = scrollbar:GetMinMaxValues();
				if ( offset == 0 ) then
					_G[scrollbar:GetName().."ScrollUpButton"]:Disable();
				else
					_G[scrollbar:GetName().."ScrollUpButton"]:Enable();
				end
				if ((scrollbar:GetValue() - max) == 0) then
					_G[scrollbar:GetName().."ScrollDownButton"]:Disable();
				else
					_G[scrollbar:GetName().."ScrollDownButton"]:Enable();
				end
				scrollbar.storedval=scrollbar:GetValue()
			</OnVerticalScroll>
			<OnMouseWheel>				
				local scrollBar=scrollBar or _G[self:GetName() .. "ScrollBar"];
				if ( delta > 0 ) then
					if IsShiftKeyDown() then 
						scrollBar:SetValue(scrollBar:GetValue() - (scrollBar:GetHeight() / 8));
					else
						scrollBar:SetValue(scrollBar:GetValue() - (scrollBar:GetHeight() / 16));
					end
				else
					if IsShiftKeyDown() then 
						scrollBar:SetValue(scrollBar:GetValue() + (scrollBar:GetHeight() / 8));
					else
						scrollBar:SetValue(scrollBar:GetValue() + (scrollBar:GetHeight() / 16));
					end
				end
			</OnMouseWheel>
		</Scripts>
	</ScrollFrame>
	
	<ScrollFrame name="UIDarkAngelScrollFrame2" virtual="true">
		<Frames>
			<Slider name="$parentScrollBar" inherits="UIDarkAngelScrollBarSlider">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="6" y="-16"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="6" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad>
				ScrollFrame_OnLoad(self);
			</OnLoad>
			<OnScrollRangeChanged>
				ScrollFrame_OnScrollRangeChanged(self, xrange, yrange);
			</OnScrollRangeChanged>
			
			<OnVerticalScroll>
			
			</OnVerticalScroll>
			<OnMouseWheel>
				local scrollBar = _G[self:GetName() .. "ScrollBar"];
				local offset = scrollBar:GetValue();
				local step = IsShiftKeyDown() and 30 or 15;
				
				if ( delta > 0 ) then
					scrollBar:SetValue(offset - step);
				else
					scrollBar:SetValue(offset + step);
				end
				
			</OnMouseWheel>
		</Scripts>
	</ScrollFrame>
	
	
